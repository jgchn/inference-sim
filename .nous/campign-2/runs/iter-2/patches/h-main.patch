+#!/usr/bin/env python3
+"""
+search_pareto_iter2.py — BLIS configuration search strategy comparison.
+
+Iteration 2: convergence speed (evals-to-95%-optimum throughput) metric.
+Compares three strategies:
+  random       -- uniform sampling from all valid configs
+  hierarchical -- Phase1: 15 tiers at max-throughput profile; Phase2: LHS top-3
+  nsga2        -- Optuna NSGAIISampler (2 objectives: throughput + latency)
+  all          -- run all three strategies sequentially
+
+Output: JSON with convergence_curve, evals_to_95pct, final_best_config.
+"""
+
+import argparse
+import json
+import random
+import re
+import subprocess
+import sys
+import time
+from pathlib import Path
+from typing import Optional
+
+import numpy as np
+import optuna
+from scipy.stats.qmc import LatinHypercube
+
+optuna.logging.set_verbosity(optuna.logging.WARNING)
+
+# ─── Search space constants ──────────────────────────────────────────────────
+
+TP_OPTIONS = [1, 2, 4, 8]
+VALID_TP_INSTANCES = [
+    (tp, ni) for tp in TP_OPTIONS for ni in range(1, 8 // tp + 1)
+]  # 15 valid (TP, instances) tiers
+
+SCHEDULER_OPTIONS = ["fcfs", "priority-fcfs", "sjf", "reverse-priority"]
+MAX_RUNNING_OPTIONS = [32, 64, 128, 256, 512]
+MAX_TOKENS_OPTIONS = [2048, 4096, 8192]
+PREFILL_THRESHOLD_OPTIONS = [0, 1024, 2048, 4096]
+BLOCK_SIZE_OPTIONS = [16, 32]
+ROUTING_OPTIONS = ["round-robin", "least-loaded", "weighted"]
+ADMISSION_OPTIONS = ["always-admit", "tier-shed"]
+PREEMPTION_OPTIONS = ["fcfs", "priority"]
+
+SECONDARY_KNOB_KEYS = [
+    "scheduler", "max_running", "max_tokens", "prefill_threshold",
+    "block_size", "routing", "admission", "preemption",
+]
+SECONDARY_KNOB_OPTIONS = [
+    SCHEDULER_OPTIONS, MAX_RUNNING_OPTIONS, MAX_TOKENS_OPTIONS,
+    PREFILL_THRESHOLD_OPTIONS, BLOCK_SIZE_OPTIONS, ROUTING_OPTIONS,
+    ADMISSION_OPTIONS, PREEMPTION_OPTIONS,
+]
+
+# Phase 1 max-throughput profile (batch=512 is critical at rate=2000 per handoff)
+PHASE1_PROFILE = {
+    "scheduler": "fcfs",
+    "max_running": 512,
+    "max_tokens": 8192,
+    "prefill_threshold": 0,
+    "block_size": 16,
+    "routing": "round-robin",
+    "admission": "always-admit",
+    "preemption": "fcfs",
+}
+
+BLIS_BINARY = "./blis"
+BLIS_MODEL = "qwen3-14b"
+BLIS_HARDWARE = "H100"
+
+
+# ─── Config helpers ───────────────────────────────────────────────────────────
+
+def build_config(tp: int, num_instances: int, scheduler: str, max_running: int,
+                 max_tokens: int, prefill_threshold: int, block_size: int,
+                 routing: str, admission: str, preemption: str) -> dict:
+    return {
+        "tp": tp,
+        "num_instances": num_instances,
+        "scheduler": scheduler,
+        "max_running": max_running,
+        "max_tokens": max_tokens,
+        "prefill_threshold": prefill_threshold,
+        "block_size": block_size,
+        "routing": routing,
+        "admission": admission,
+        "preemption": preemption,
+    }
+
+
+def config_from_secondary(tp: int, num_instances: int, secondary: dict) -> dict:
+    return build_config(tp=tp, num_instances=num_instances, **secondary)
+
+
+# ─── BLIS runner ─────────────────────────────────────────────────────────────
+
+def parse_cluster_metrics(stdout: str) -> dict:
+    """Extract cluster-level metrics block from BLIS stdout."""
+    blocks = re.findall(r"=== Simulation Metrics ===\s*(\{.*?\})", stdout, re.DOTALL)
+    # Cluster block is the last one when multiple instances exist
+    for block_str in reversed(blocks):
+        try:
+            data = json.loads(block_str)
+            if data.get("instance_id") == "cluster" or len(blocks) == 1:
+                return data
+        except json.JSONDecodeError:
+            continue
+    return {}
+
+
+def run_blis(config: dict, num_requests: int, rate: float, seed: int) -> Optional[dict]:
+    """Run BLIS. Returns {'tokens_per_sec': float, 'e2e_p99_ms': float} or None on failure."""
+    cmd = [
+        BLIS_BINARY, "run",
+        "--model", BLIS_MODEL,
+        "--hardware", BLIS_HARDWARE,
+        "--latency-model", "trained-physics",
+        "--tp", str(config["tp"]),
+        "--num-instances", str(config["num_instances"]),
+        "--rate", str(rate),
+        "--num-requests", str(num_requests),
+        "--seed", str(seed),
+        "--scheduler", config["scheduler"],
+        "--max-num-running-reqs", str(config["max_running"]),
+        "--max-num-scheduled-tokens", str(config["max_tokens"]),
+        "--long-prefill-token-threshold", str(config["prefill_threshold"]),
+        "--block-size-in-tokens", str(config["block_size"]),
+        "--routing-policy", config["routing"],
+        "--admission-policy", config["admission"],
+        "--preemption-policy", config["preemption"],
+    ]
+    try:
+        result = subprocess.run(cmd, capture_output=True, text=True, timeout=120)
+        if result.returncode != 0:
+            print(f"BLIS error (exit {result.returncode}): {result.stderr[:200]}", file=sys.stderr)
+            return None
+        metrics = parse_cluster_metrics(result.stdout)
+        if not metrics:
+            print(f"BLIS parse error: no cluster metrics in stdout", file=sys.stderr)
+            return None
+        return {
+            "tokens_per_sec": float(metrics.get("tokens_per_sec", 0.0)),
+            "e2e_p99_ms": float(metrics.get("e2e_p99_ms", float("inf"))),
+        }
+    except subprocess.TimeoutExpired:
+        print(f"BLIS timeout for config {config}", file=sys.stderr)
+        return None
+    except Exception as e:
+        print(f"BLIS exception: {e}", file=sys.stderr)
+        return None
+
+
+# ─── Convergence utilities ────────────────────────────────────────────────────
+
+def compute_evals_to_threshold(curve: list, threshold: float) -> Optional[int]:
+    """Return 1-based eval index when best_so_far first reaches threshold, or None."""
+    for i, val in enumerate(curve):
+        if val >= threshold:
+            return i + 1
+    return None
+
+
+def budget_snapshots(curve: list) -> dict:
+    """Best throughput at fixed eval counts."""
+    result = {}
+    for b in [15, 20, 50, 100, 200, 500]:
+        if b <= len(curve):
+            result[str(b)] = round(curve[b - 1], 2)
+    return result
+
+
+# ─── Random search ────────────────────────────────────────────────────────────
+
+def sample_random_config(rng: random.Random) -> dict:
+    tp, ni = rng.choice(VALID_TP_INSTANCES)
+    return build_config(
+        tp=tp,
+        num_instances=ni,
+        scheduler=rng.choice(SCHEDULER_OPTIONS),
+        max_running=rng.choice(MAX_RUNNING_OPTIONS),
+        max_tokens=rng.choice(MAX_TOKENS_OPTIONS),
+        prefill_threshold=rng.choice(PREFILL_THRESHOLD_OPTIONS),
+        block_size=rng.choice(BLOCK_SIZE_OPTIONS),
+        routing=rng.choice(ROUTING_OPTIONS),
+        admission=rng.choice(ADMISSION_OPTIONS),
+        preemption=rng.choice(PREEMPTION_OPTIONS),
+    )
+
+
+def random_search(budget: int, num_requests: int, rate: float, seed: int) -> dict:
+    rng = random.Random(seed)
+    best_throughput = 0.0
+    best_config = None
+    best_e2e_p99 = None
+    convergence_curve = []
+
+    for i in range(budget):
+        if (i + 1) % 50 == 0:
+            print(f"  [random] eval {i+1}/{budget}, best={best_throughput:.0f}", flush=True)
+        config = sample_random_config(rng)
+        result = run_blis(config, num_requests, rate, seed)
+        if result is not None and result["tokens_per_sec"] > best_throughput:
+            best_throughput = result["tokens_per_sec"]
+            best_config = config
+            best_e2e_p99 = result["e2e_p99_ms"]
+        convergence_curve.append(best_throughput)
+
+    return {
+        "convergence_curve": convergence_curve,
+        "final_best_throughput": best_throughput,
+        "final_best_config": best_config,
+        "final_best_e2e_p99": best_e2e_p99,
+    }
+
+
+# ─── Hierarchical search ──────────────────────────────────────────────────────
+
+def lhs_sample_secondary(n_samples: int, rng_seed: int) -> list:
+    """Generate n secondary-knob configs via Latin Hypercube Sampling."""
+    n_dims = len(SECONDARY_KNOB_KEYS)
+    sampler = LatinHypercube(d=n_dims, seed=rng_seed)
+    unit_samples = sampler.random(n=n_samples)  # shape (n_samples, n_dims)
+
+    configs = []
+    for row in unit_samples:
+        secondary = {}
+        for dim_idx, (key, options) in enumerate(zip(SECONDARY_KNOB_KEYS, SECONDARY_KNOB_OPTIONS)):
+            option_idx = min(int(row[dim_idx] * len(options)), len(options) - 1)
+            secondary[key] = options[option_idx]
+        configs.append(secondary)
+    return configs
+
+
+def hierarchical_search(budget: int, num_requests: int, rate: float, seed: int) -> dict:
+    """
+    Phase 1: Evaluate all 15 (TP, instances) tiers with max-throughput profile.
+             Budget used: 15 evaluations.
+    Phase 2: Allocate remaining budget to top-3 tiers via Latin Hypercube Sampling.
+    """
+    best_throughput = 0.0
+    best_config = None
+    best_e2e_p99 = None
+    convergence_curve = []
+
+    # ── Phase 1: evaluate all 15 tiers ──────────────────────────────────────
+    phase1_results = []
+    print(f"  [hierarchical] Phase 1: evaluating {len(VALID_TP_INSTANCES)} tiers...", flush=True)
+    for tp, ni in VALID_TP_INSTANCES:
+        config = config_from_secondary(tp, ni, PHASE1_PROFILE)
+        result = run_blis(config, num_requests, rate, seed)
+        tps = result["tokens_per_sec"] if result else 0.0
+        e2e = result["e2e_p99_ms"] if result else float("inf")
+        phase1_results.append({"tp": tp, "num_instances": ni, "tokens_per_sec": tps, "e2e_p99_ms": e2e})
+        if tps > best_throughput:
+            best_throughput = tps
+            best_config = config
+            best_e2e_p99 = e2e
+        convergence_curve.append(best_throughput)
+
+    # Sort tiers by throughput descending, pick top-3
+    phase1_sorted = sorted(phase1_results, key=lambda x: x["tokens_per_sec"], reverse=True)
+    top3_tiers = [(r["tp"], r["num_instances"]) for r in phase1_sorted[:3]]
+    print(f"  [hierarchical] Top-3 tiers: {top3_tiers}", flush=True)
+
+    # ── Phase 2: LHS within top-3 tiers ──────────────────────────────────────
+    phase2_budget = max(0, budget - len(VALID_TP_INSTANCES))
+    per_tier_budget = max(0, phase2_budget // 3)
+    remainder = phase2_budget - per_tier_budget * 3
+    # Give any remainder to the best tier; tiers may get 0 if budget is very small
+    tier_budgets = [per_tier_budget + remainder, per_tier_budget, per_tier_budget]
+
+    print(f"  [hierarchical] Phase 2: {phase2_budget} evals across top-3 tiers "
+          f"(budgets: {tier_budgets})", flush=True)
+
+    for tier_idx, ((tp, ni), tier_budget) in enumerate(zip(top3_tiers, tier_budgets)):
+        if tier_budget == 0:
+            continue
+        lhs_seed = seed * 100 + tier_idx
+        secondary_samples = lhs_sample_secondary(tier_budget, lhs_seed)
+        for j, secondary in enumerate(secondary_samples):
+            if (j + 1) % 100 == 0:
+                print(f"  [hierarchical] tier {tier_idx+1} eval {j+1}/{tier_budget}, "
+                      f"best={best_throughput:.0f}", flush=True)
+            config = config_from_secondary(tp, ni, secondary)
+            result = run_blis(config, num_requests, rate, seed)
+            tps = result["tokens_per_sec"] if result else 0.0
+            e2e = result["e2e_p99_ms"] if result else float("inf")
+            if tps > best_throughput:
+                best_throughput = tps
+                best_config = config
+                best_e2e_p99 = e2e
+            convergence_curve.append(best_throughput)
+
+    return {
+        "convergence_curve": convergence_curve,
+        "final_best_throughput": best_throughput,
+        "final_best_config": best_config,
+        "final_best_e2e_p99": best_e2e_p99,
+        "phase1_tier_ranking": phase1_sorted,
+        "top3_tiers": [{"tp": tp, "num_instances": ni} for tp, ni in top3_tiers],
+    }
+
+
+# ─── NSGA-II search ───────────────────────────────────────────────────────────
+
+def nsga2_search(budget: int, num_requests: int, rate: float, seed: int) -> dict:
+    """
+    NSGA-II via Optuna (NSGAIISampler, population_size=20).
+    Objectives: maximize tokens_per_sec, minimize e2e_p99_ms.
+    First 20 trials are random warmup (implicit in NSGA-II).
+    """
+    best_throughput = 0.0
+    best_config = None
+    best_e2e_p99 = None
+    convergence_curve = []
+    eval_counter = [0]
+
+    sampler = optuna.samplers.NSGAIISampler(population_size=20, seed=seed)
+    study = optuna.create_study(
+        directions=["maximize", "minimize"],
+        sampler=sampler,
+    )
+
+    def objective(trial):
+        tp_idx = trial.suggest_int("tp_idx", 0, len(VALID_TP_INSTANCES) - 1)
+        tp, ni = VALID_TP_INSTANCES[tp_idx]
+        scheduler = trial.suggest_categorical("scheduler", SCHEDULER_OPTIONS)
+        max_running = trial.suggest_categorical("max_running", MAX_RUNNING_OPTIONS)
+        max_tokens = trial.suggest_categorical("max_tokens", MAX_TOKENS_OPTIONS)
+        prefill_threshold = trial.suggest_categorical("prefill_threshold", PREFILL_THRESHOLD_OPTIONS)
+        block_size = trial.suggest_categorical("block_size", BLOCK_SIZE_OPTIONS)
+        routing = trial.suggest_categorical("routing", ROUTING_OPTIONS)
+        admission = trial.suggest_categorical("admission", ADMISSION_OPTIONS)
+        preemption = trial.suggest_categorical("preemption", PREEMPTION_OPTIONS)
+
+        config = build_config(
+            tp=tp, num_instances=ni, scheduler=scheduler, max_running=max_running,
+            max_tokens=max_tokens, prefill_threshold=prefill_threshold,
+            block_size=block_size, routing=routing, admission=admission,
+            preemption=preemption,
+        )
+        result = run_blis(config, num_requests, rate, seed)
+        tps = result["tokens_per_sec"] if result else 0.0
+        e2e = result["e2e_p99_ms"] if result else 1e9
+
+        # Track convergence (closure over outer variables)
+        nonlocal best_throughput, best_config, best_e2e_p99
+        eval_counter[0] += 1
+        if (eval_counter[0]) % 50 == 0:
+            print(f"  [nsga2] eval {eval_counter[0]}/{budget}, best={best_throughput:.0f}", flush=True)
+        if tps > best_throughput:
+            best_throughput = tps
+            best_config = config
+            best_e2e_p99 = e2e
+        convergence_curve.append(best_throughput)
+
+        return tps, e2e
+
+    study.optimize(objective, n_trials=budget)
+
+    return {
+        "convergence_curve": convergence_curve,
+        "final_best_throughput": best_throughput,
+        "final_best_config": best_config,
+        "final_best_e2e_p99": best_e2e_p99,
+    }
+
+
+# ─── Strategy runner + output ─────────────────────────────────────────────────
+
+def run_strategy(strategy: str, budget: int, num_requests: int, rate: float,
+                 seed: int, known_optimum: float, output: str) -> dict:
+    print(f"[{strategy}] Starting: budget={budget}, rate={rate}, "
+          f"num_requests={num_requests}, seed={seed}", flush=True)
+    t0 = time.time()
+
+    if strategy == "random":
+        results = random_search(budget, num_requests, rate, seed)
+    elif strategy == "hierarchical":
+        results = hierarchical_search(budget, num_requests, rate, seed)
+    elif strategy == "nsga2":
+        results = nsga2_search(budget, num_requests, rate, seed)
+    else:
+        raise ValueError(f"Unknown strategy: {strategy}")
+
+    elapsed = time.time() - t0
+    threshold_95 = known_optimum * 0.95
+    evals_to_95 = compute_evals_to_threshold(results["convergence_curve"], threshold_95)
+
+    output_data = {
+        "metadata": {
+            "strategy": strategy,
+            "budget": budget,
+            "rate": rate,
+            "num_requests": num_requests,
+            "seed": seed,
+            "known_optimum": known_optimum,
+            "threshold_95pct": threshold_95,
+            "elapsed_seconds": round(elapsed, 2),
+        },
+        "convergence_curve": [round(v, 2) for v in results["convergence_curve"]],
+        "evals_to_95pct": evals_to_95,
+        "final_best_throughput": round(results["final_best_throughput"], 2),
+        "final_best_config": results["final_best_config"],
+        "final_best_e2e_p99": round(results["final_best_e2e_p99"], 2) if results["final_best_e2e_p99"] else None,
+        "budget_snapshots": budget_snapshots(results["convergence_curve"]),
+    }
+    if "phase1_tier_ranking" in results:
+        output_data["phase1_tier_ranking"] = results["phase1_tier_ranking"]
+    if "top3_tiers" in results:
+        output_data["top3_tiers"] = results["top3_tiers"]
+
+    Path(output).parent.mkdir(parents=True, exist_ok=True)
+    with open(output, "w") as f:
+        json.dump(output_data, f, indent=2)
+
+    print(f"[{strategy}] Done in {elapsed:.1f}s. "
+          f"Best: {results['final_best_throughput']:.0f} tok/s, "
+          f"evals_to_95pct: {evals_to_95}  (threshold={threshold_95:.0f})", flush=True)
+    return output_data
+
+
+# ─── Main ─────────────────────────────────────────────────────────────────────
+
+def main():
+    parser = argparse.ArgumentParser(description="BLIS convergence search comparison (iter-2)")
+    parser.add_argument("--strategy", choices=["random", "hierarchical", "nsga2", "all"],
+                        required=True)
+    parser.add_argument("--budget", type=int, default=500)
+    parser.add_argument("--rate", type=float, default=2000.0)
+    parser.add_argument("--num-requests", type=int, default=1000)
+    parser.add_argument("--seed", type=int, default=42)
+    parser.add_argument("--known-optimum", type=float, required=True,
+                        help="True optimal throughput tok/s for 95%% threshold computation")
+    parser.add_argument("--output", required=True,
+                        help="Output JSON path. For --strategy all, used as prefix (appends _<strategy>.json)")
+    args = parser.parse_args()
+
+    if args.strategy == "all":
+        all_results = {}
+        for strategy in ["random", "hierarchical", "nsga2"]:
+            out_path = f"{args.output}_{strategy}.json"
+            all_results[strategy] = run_strategy(
+                strategy, args.budget, args.num_requests, args.rate,
+                args.seed, args.known_optimum, out_path
+            )
+        # Write combined summary
+        summary_path = f"{args.output}_summary.json"
+        threshold_95 = args.known_optimum * 0.95
+        summary = {
+            "metadata": {
+                "budget": args.budget,
+                "rate": args.rate,
+                "num_requests": args.num_requests,
+                "seed": args.seed,
+                "known_optimum": args.known_optimum,
+                "threshold_95pct": threshold_95,
+            },
+            "strategies": {
+                s: {
+                    "evals_to_95pct": r["evals_to_95pct"],
+                    "final_best_throughput": r["final_best_throughput"],
+                    "budget_snapshots": r["budget_snapshots"],
+                }
+                for s, r in all_results.items()
+            },
+        }
+        with open(summary_path, "w") as f:
+            json.dump(summary, f, indent=2)
+        print(f"\nSummary written to {summary_path}", flush=True)
+        print("\n=== CONVERGENCE SUMMARY ===", flush=True)
+        for s, r in all_results.items():
+            print(f"  {s:15s}: evals_to_95pct={r['evals_to_95pct']}, "
+                  f"final_best={r['final_best_throughput']:.0f} tok/s", flush=True)
+    else:
+        run_strategy(
+            args.strategy, args.budget, args.num_requests, args.rate,
+            args.seed, args.known_optimum, args.output
+        )
+
+
+if __name__ == "__main__":
+    main()
